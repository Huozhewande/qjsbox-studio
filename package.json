{
  "name": "qjsbox-studio",
  "version": "0.1.0",
  "description": "React components to author three-valued rules, rule flows and factors that run in the qjsbox sandbox.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/Huozhewande/qjsbox-studio.git" },
  "keywords": ["rules-engine", "rule-builder", "react", "quickjs", "qjsbox", "react-flow"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/qjsbox-studio.css"
  },
  "files": ["dist", "README.md", "README.zh-CN.md", "LICENSE", "NOTICE"],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
