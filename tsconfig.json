{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "qjsbox-studio": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "demo",
    "vite.config.ts"
  ],
  "exclude": [
    "demo/vite.config.ts",
    "demo/dist",
    "dist"
  ]
}
